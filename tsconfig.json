{
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "."
	},
	"include": [
		"apps/api/**/*.ts",
		"apps/worker/**/*.ts",
		"libs/**/*.ts",
		"scripts/**/*.ts",
		"test/**/*.ts",
		"vitest*.ts",
		"oxlint.config.ts"
	],
	"exclude": ["node_modules", "dist"]
}

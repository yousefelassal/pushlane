{
  "name": "pushlane",
  "version": "0.1.0",
  "private": true,
  "description": "Open source transactional push for native apps and the web.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "nest build --all",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm sdk:build && pnpm dashboard:build && pnpm docs:build",
    "dashboard:build": "pnpm --filter @pushlane/dashboard build",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "dev": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start api --watch",
    "dev:worker": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start worker --watch",
    "docs:build": "pnpm --filter @pushlane/docs build",
    "docs:dev": "pnpm --filter @pushlane/docs dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --max-warnings=0",
    "lint:fix": "oxlint --type-aware --fix",
    "project:create": "tsx --env-file-if-exists=.env scripts/create-project.ts",
    "sdk:build": "pnpm --filter @pushlane/sdk build",
    "setup:local": "tsx scripts/setup.ts",
    "smoke": "pnpm build && pnpm dashboard:build && tsx --env-file-if-exists=.env scripts/smoke.ts",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/apps/worker/src/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @pushlane/sdk typecheck"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/throttler": "6.8.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.6.2",
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "@types/web-push": "3.6.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.8.1",
    "prettier-plugin-packagejson": "3.0.2",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  }
}

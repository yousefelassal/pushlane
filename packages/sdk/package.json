{
	"name": "@pushlane/sdk",
	"version": "0.1.0",
	"description": "Server, browser, and service worker clients for Pushlane.",
	"type": "module",
	"license": "Apache-2.0",
	"files": [
		"dist"
	],
	"exports": {
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js"
		},
		"./service-worker": {
			"types": "./dist/service-worker.d.ts",
			"import": "./dist/service-worker.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=20"
	}
}
